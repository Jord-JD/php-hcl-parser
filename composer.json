{
  "name": "jord-jd/php-hcl-parser",
  "description": "PHP HCL Parser",
  "type": "library",
  "license": "LGPL-3.0-only",
  "authors": [
    {
      "name": "Jordan Hall",
      "email": "jordan@hall05.co.uk"
    }
  ],
  "require": {
    "php": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "DivineOmega\\HCLParser\\": "./src/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "DivineOmega\\HCLParser\\Installer::installBinaries"
    ]
  },
  "replace": {
    "divineomega/php-hcl-parser": "self.version"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "2.0-dev"
    }
  }
}
